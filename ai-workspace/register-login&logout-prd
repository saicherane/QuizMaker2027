### Implementation Patterns

**Repository — parameterized D1 query:**

```typescript
// src/lib/repositories/user-repository.ts
import type { D1Database } from "@cloudflare/workers-types";

export async function findByEmailId(db: D1Database, emailId: string) {
  const { results } = await db
    .prepare("SELECT * FROM users WHERE email_id = ?1 COLLATE NOCASE")
    .bind(emailId)
    .all<UserRow>();
  return results[0] ?? null;
}
```

**Service — register with uniqueness check:**

```typescript
// src/lib/services/user-service.ts
export async function register(db: D1Database, input: RegisterInput): Promise<SafeUser> {
  const existing = await userRepo.findByEmailId(db, input.emailId);
  if (existing) throw new AppError("CONFLICT", "Email already registered");

  const salt = generateSalt();
  const passwordHash = await hashPassword(input.password, salt);
  const user = await userRepo.createUser(db, {
    username: input.username,
    emailId: input.emailId,
    passwordHash,
    passwordSalt: salt,
  });
  return toSafeUser(user);
}
```

**Controller — Server Action:**

```typescript
// src/app/(auth)/register/actions.ts
"use server";

import { redirect } from "next/navigation";
import { getCloudflareContext } from "@opennextjs/cloudflare";
import { registerSchema } from "@/lib/validators/user";
import * as userService from "@/lib/services/user-service";

export async function registerUser(formData: FormData) {
  const parsed = registerSchema.safeParse(Object.fromEntries(formData));
  if (!parsed.success) return { errors: parsed.error.flatten().fieldErrors };

  const { env } = await getCloudflareContext();
  await userService.register(env.DB, parsed.data);
  redirect("/login?registered=1");
}
```

**Session cookie (HTTP-only, Secure in production):**

```typescript
// src/lib/auth/session.ts
const SESSION_COOKIE = "qm_session";
const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 days

export function sessionCookieOptions(maxAge: number) {
  return {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax" as const,
    path: "/",
    maxAge,
  };
}
```

### Important Notes

- **Never return `password_hash` or `password_salt`** in API responses or page props; use a `SafeUser` type that omits sensitive fields
- **Use numbered placeholders** (`?1`, `?2`) in all D1 queries per project conventions
- **Prefer `all()` over `first()`** for D1 query results
- **Run `npm run preview`** to test auth flows on the actual Workers runtime before considering the feature complete
- **Session secret** must be set in `.dev.vars` locally and via `wrangler secret put SESSION_SECRET` in production
- Controllers and middleware are the only layers that interact with cookies and redirects
- **TDD is mandatory**: write or update tests in the same PR/commit as implementation; do not merge code with failing phase tests
- Run `npm run test` after every implementation step; red → green is the expected cycle

