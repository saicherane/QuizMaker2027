### Implementation Patterns

**Service — create MCQ with choices:**

```typescript
// src/lib/services/mcq-service.ts
export async function createMcq(
  db: D1Database,
  userId: string,
  input: McqFormInput,
): Promise<McqWithChoices> {
  // Zod already ran in controller; enforce 2–6 + one correct again for defense in depth
  assertValidChoices(input.choices);

  const mcq = await mcqRepo.createMcq(db, {
    name: input.name,
    question: input.question,
    createdBy: userId,
  });

  const choices = await choiceRepo.createChoices(db, mcq.mcqId, input.choices);
  return { ...mcq, choices };
}
```

**Controller — create with auth:**

```typescript
// src/app/(app)/questions/new/actions.ts
"use server";

import { redirect } from "next/navigation";
import { getCloudflareContext } from "@opennextjs/cloudflare";
import { getCurrentUser } from "@/lib/auth/get-current-user";
import { mcqFormSchema } from "@/lib/validators/mcq";
import * as mcqService from "@/lib/services/mcq-service";

export async function createMcq(formData: FormData) {
  const user = await getCurrentUser();
  if (!user) return { error: "Not authenticated" };

  const parsed = mcqFormSchema.safeParse(parseMcqFormData(formData));
  if (!parsed.success) return { errors: parsed.error.flatten().fieldErrors };

  const { env } = await getCloudflareContext();
  await mcqService.createMcq(env.DB, user.userId, parsed.data);
  redirect("/questions");
}
```

**Replace choices on update (transactional pattern):**

```typescript
// In mcq-service updateMcq:
await assertOwner(db, mcqId, userId);
await mcqRepo.updateMcq(db, mcqId, { name, question });
await choiceRepo.replaceChoicesForMcq(db, mcqId, choices);
```

### Important Notes

- **Choice replacement on edit**: Delete all existing choices for the MCQ and insert new rows (simpler than per-row diff); `attempt.choice_id` FK may require `ON DELETE CASCADE` on choices (already set) — old attempts remain valid only if choice IDs unchanged; for phase 1, replacing choices invalidates old attempt FK references — acceptable for practice attempts, or delete attempts on update (document choice in implementation)
- **Shadcn**: Install missing UI primitives before Phase 4 (`dropdown-menu`, `textarea`, `alert-dialog`)
- **Navigation**: Add `/questions` to protected routes; unauthenticated access redirects to `/login`
- **TDD mandatory**: red → green per phase; do not skip repository tests
- Run `npm run preview` before marking feature complete

